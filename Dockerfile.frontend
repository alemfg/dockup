FROM node:20-alpine AS builder
WORKDIR /app

# Build arg passed from docker-compose (defaults to 8000)
ARG BRAIN_API_PORT=8000

COPY frontend/package.json ./
RUN npm install
COPY frontend/ .

# Inject the API port into Vite's env so it ends up in the built JS
ENV VITE_API_PORT=${BRAIN_API_PORT}
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# Generate nginx.conf from template, substituting the brain port
COPY docker/nginx.conf.template /etc/nginx/nginx.conf.template
ARG BRAIN_API_PORT=8000
RUN sed "s/BRAIN_API_PORT_PLACEHOLDER/${BRAIN_API_PORT}/g" \
      /etc/nginx/nginx.conf.template \
      > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
