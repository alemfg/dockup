FROM python:3.12-slim

ARG ARBX_VERSION=unknown
ARG BUILD_DATE=unknown
LABEL description="ARBX Worker Manager" \
      arbx.version="${ARBX_VERSION}" \
      arbx.build_date="${BUILD_DATE}" \
      arbx.component="worker_manager"

ENV ARBX_BUILD_VERSION=${ARBX_VERSION}
ENV ARBX_BUILD_DATE=${BUILD_DATE}
ENV ARBX_COMPONENT=worker_manager

RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir \
    redis[asyncio]>=5.0.1 \
    docker>=7.0.0 \
    python-dotenv>=1.0.0 \
    pydantic>=2.5.0 \
    pyyaml>=6.0

COPY messaging/ ./messaging/
COPY worker_manager/ ./worker_manager/
COPY config/ ./config/

CMD ["python", "-m", "worker_manager.manager"]
