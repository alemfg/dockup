{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Your Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "ARBX Distributed Arbitrage Engine — Brain and Worker monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "type": "row", "title": "🧠 Brain Health", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "id": 1, "collapsed": false },

    {
      "id": 2, "type": "stat", "title": "Brain Status",
      "gridPos": { "x": 0, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_brain_up", "legendFormat": "" }]
    },

    {
      "id": 3, "type": "stat", "title": "Uptime",
      "gridPos": { "x": 3, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_brain_uptime_seconds", "legendFormat": "" }]
    },

    {
      "id": 4, "type": "stat", "title": "Trading Mode",
      "gridPos": { "x": 6, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "disabled": { "text": "DISABLED", "color": "gray" }, "simulate": { "text": "SIMULATE", "color": "blue" }, "live": { "text": "LIVE", "color": "red" } } }
          ]
        }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "label_replace(arbx_brain_trading_info, \"mode\", \"$1\", \"mode\", \"(.*)\")", "legendFormat": "{{mode}}" }]
    },

    {
      "id": 5, "type": "stat", "title": "Total Balance (USD)",
      "gridPos": { "x": 9, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_market_total_balance_usd", "legendFormat": "" }]
    },

    {
      "id": 6, "type": "stat", "title": "Risk Halted",
      "gridPos": { "x": 12, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "HALTED", "color": "red" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_risk_halted", "legendFormat": "" }]
    },

    {
      "id": 7, "type": "stat", "title": "Open Positions",
      "gridPos": { "x": 15, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_positions_open", "legendFormat": "" }]
    },

    {
      "id": 8, "type": "stat", "title": "Realised P&L (USD)",
      "gridPos": { "x": 18, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": -9999 }, { "color": "yellow", "value": 0 }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_pnl_realised_total_usd", "legendFormat": "" }]
    },

    {
      "id": 9, "type": "stat", "title": "Win Rate",
      "gridPos": { "x": 21, "y": 1, "w": 3, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 40 }, { "color": "green", "value": 55 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_trades_win_rate_pct", "legendFormat": "" }]
    },

    { "type": "row", "title": "🖥 Workers", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "id": 10, "collapsed": false },

    {
      "id": 11, "type": "stat", "title": "Workers Total / Healthy / Dead",
      "gridPos": { "x": 0, "y": 6, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_workers_total",   "legendFormat": "Total" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_workers_healthy", "legendFormat": "Healthy" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_workers_dead",    "legendFormat": "Dead" }
      ]
    },

    {
      "id": 12, "type": "timeseries", "title": "Worker Latency (ms)",
      "gridPos": { "x": 6, "y": 6, "w": 10, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_worker_latency_ms", "legendFormat": "{{worker_id}}" }]
    },

    {
      "id": 13, "type": "timeseries", "title": "Ticks per Minute (per worker)",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_worker_ticks_per_minute", "legendFormat": "{{worker_id}}" }]
    },

    {
      "id": 14, "type": "table", "title": "Worker Status Table",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 8 },
      "options": { "sortBy": [{ "displayName": "Worker", "desc": false }] },
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Status" }, { "id": "custom.width", "value": 80 }, { "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "●", "color": "green" }, "0.5": { "text": "●", "color": "yellow" }, "0": { "text": "●", "color": "red" } } }] }] },
          { "matcher": { "id": "byName", "options": "worker_id" }, "properties": [{ "id": "displayName", "value": "Worker" }] },
          { "matcher": { "id": "byName", "options": "exchange" }, "properties": [{ "id": "displayName", "value": "Exchange" }] }
        ]
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_worker_status", "legendFormat": "", "instant": true, "format": "table" }]
    },

    { "type": "row", "title": "📊 Market", "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 }, "id": 20, "collapsed": false },

    {
      "id": 21, "type": "stat", "title": "Price Contexts",
      "gridPos": { "x": 0, "y": 19, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_market_price_contexts", "legendFormat": "" }]
    },

    {
      "id": 22, "type": "stat", "title": "Stale Pairs",
      "gridPos": { "x": 4, "y": 19, "w": 4, "h": 3 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_market_stale_pairs", "legendFormat": "" }]
    },

    {
      "id": 23, "type": "timeseries", "title": "Top Pair Spreads (%)",
      "gridPos": { "x": 8, "y": 19, "w": 16, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "topk(5, arbx_market_spread_pct)", "legendFormat": "{{pair}}" }]
    },

    {
      "id": 24, "type": "timeseries", "title": "BTC/USDT Price (all exchanges)",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 7 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_market_pair_price{pair=\"BTC/USDT\"}", "legendFormat": "{{exchange}}" }]
    },

    {
      "id": 25, "type": "timeseries", "title": "ETH/USDT Price (all exchanges)",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 7 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_market_pair_price{pair=\"ETH/USDT\"}", "legendFormat": "{{exchange}}" }]
    },

    { "type": "row", "title": "💹 P&L & Risk", "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }, "id": 30, "collapsed": false },

    {
      "id": 31, "type": "timeseries", "title": "Realised P&L (cumulative USD)",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": -9999 }, { "color": "green", "value": 0 }] }
        }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_pnl_realised_total_usd", "legendFormat": "Total P&L" }]
    },

    {
      "id": 32, "type": "gauge", "title": "Daily Loss vs Limit",
      "gridPos": { "x": 12, "y": 30, "w": 6, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizValue": 0, "maxVizValue": 100 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 }] },
          "color": { "mode": "thresholds" },
          "min": 0, "max": 100
        }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_risk_daily_loss_usd / arbx_risk_daily_loss_limit_usd * 100", "legendFormat": "Daily Loss %" }]
    },

    {
      "id": 33, "type": "gauge", "title": "Drawdown from Peak",
      "gridPos": { "x": 18, "y": 30, "w": 6, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizValue": 0, "maxVizValue": 100 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 8 }] },
          "color": { "mode": "thresholds" },
          "min": 0, "max": 20
        }
      },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_risk_drawdown_pct", "legendFormat": "Drawdown %" }]
    },

    {
      "id": 34, "type": "timeseries", "title": "Unrealised P&L by Position (USD)",
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 7 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_position_unrealised_pnl_usd", "legendFormat": "{{pair}} ({{exchange}})" }]
    },

    {
      "id": 35, "type": "timeseries", "title": "Graph Arb — Profitable Paths",
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 7 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 } } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_graph_paths_found",      "legendFormat": "Paths found" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_graph_best_profit_pct",  "legendFormat": "Best profit %" }
      ]
    },

    { "type": "row", "title": "⚡ Orders & Signals", "gridPos": { "x": 0, "y": 45, "w": 24, "h": 1 }, "id": 40, "collapsed": false },

    {
      "id": 41, "type": "timeseries", "title": "Signal Score by Pair",
      "gridPos": { "x": 0, "y": 46, "w": 12, "h": 7 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "lineWidth": 2 } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_signal_score", "legendFormat": "{{exchange}} {{pair}}" }]
    },

    {
      "id": 42, "type": "stat", "title": "Active CR Setups",
      "gridPos": { "x": 12, "y": 46, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "gray", "value": 0 }, { "color": "green", "value": 1 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_cr_setups_active", "legendFormat": "" }]
    },

    {
      "id": 43, "type": "stat", "title": "Open Orders",
      "gridPos": { "x": 16, "y": 46, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 6 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_orders_open", "legendFormat": "" }]
    },

    {
      "id": 44, "type": "stat", "title": "Consecutive Losses",
      "gridPos": { "x": 20, "y": 46, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 4 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "arbx_risk_consecutive_losses", "legendFormat": "" }]
    }

  ],
  "refresh": "15s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["arbx", "crypto", "arbitrage"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ARBX — Brain & Workers",
  "uid": "arbx-main-v1",
  "version": 1
}
