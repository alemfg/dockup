# ═══════════════════════════════════════════════════════════════════════════════
# ARBX — Your Personal Overrides (.env.local)
#
# Copy this file to config/.env.local and fill in your values.
# This file is NEVER overwritten by upgrades.
#
# ── Priority (highest → lowest) ─────────────────────────────────────────────
# 1. Variables set here (.env.local)          ← YOU WIN
# 2. Variables in config/.env                 ← shipped defaults
#
# ANY variable from .env can be overridden here. Common ones:
#   BRAIN_API_PORT, BRAIN_METRICS_PORT, FRONTEND_PORT
#   EXCHANGES, BINANCE_PAIRS, MAX_WORKERS
#   API keys, wallet addresses, fee settings
#
# You only need to copy the lines you want to change — everything
# else comes from .env automatically.
#
# Everything else lives in config/.env (shipped defaults) or config.yaml.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Secrets — put your real values here ───────────────────────────────────────
# POSTGRES_PASSWORD=change_me_to_something_strong

# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/YOUR_KEY

# ── Alerts ─────────────────────────────────────────────────────────────────────
# NTFY_TOPIC=arbx-alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_URL=

# ── Personal tuning (override defaults from .env) ─────────────────────────────
# Uncomment and change only what you want to override.
#
# TRADING_MODE=simulate         # disabled | simulate | live
# DRY_RUN=true
# LOG_LEVEL=INFO

# GRAPH_ALGORITHM=bellman_ford  # bellman_ford | floyd_warshall
# GRAPH_MIN_SPREAD_PCT=0.25     # raise to 0.40 if using DEX legs
# GRAPH_MAX_HOPS=5
# GRAPH_MIN_HOPS=3

# FEE_BINANCE_PCT=0.075         # your actual tier (0.1 standard, 0.075 with BNB)
# FEE_KRAKEN_PCT=0.16           # drops to 0.10 above $50k/month volume

# MAX_DAILY_LOSS_USD=500
# MAX_CAPITAL_PER_TRADE=1000
