# ═══════════════════════════════════════════════════════════════════════════════
# ARBX v4.4 — Shipped Defaults
#
# This file is OVERWRITTEN on every upgrade. Do NOT put secrets here.
# Put your API keys, passwords, and personal overrides in config/.env.local
# which is never touched by upgrades.
#
# Load order: .env (this file) → .env.local (your overrides win)
# See config/.env.local.example for what to put in .env.local.
# See config/.env.example for the full reference of every available variable.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Ports ──────────────────────────────────────────────────────────────────────
BRAIN_API_PORT=8000
BRAIN_METRICS_PORT=9090
FRONTEND_PORT=3000
REDIS_PORT=6379
POSTGRES_PORT=5432

# ── Brain ──────────────────────────────────────────────────────────────────────
DRY_RUN=true
LOG_LEVEL=INFO
BRAIN_API_HOST=0.0.0.0
TRADING_MODE=disabled

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=arbitrage_secret

# ── Worker pair lists ──────────────────────────────────────────────────────────
# ── Worker auto-spawn (v4.6) ─────────────────────────────────────────────────
# List exchanges here — brain spawns one worker per exchange automatically.
# No docker-compose worker blocks needed. worker_manager must be running.
EXCHANGES=binance,kraken,bybit,uniswap

# Pairs per exchange. Use ALL to fetch the full market list from the exchange.
# For ALL: only spot pairs with PAIRS_ALL_QUOTE_FILTER quotes are included.
BINANCE_PAIRS=BTC/USDT,ETH/USDT,BTC/ETH,SOL/USDT,SOL/BTC,BNB/USDT,BNB/BTC,XRP/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,MATIC/USDT
KRAKEN_PAIRS=BTC/USDT,ETH/USDT,BTC/ETH,SOL/USDT,XRP/USDT,BTC/EUR,ETH/EUR,XRP/EUR,SOL/EUR,DOT/USDT
BYBIT_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,AVAX/USDT,DOGE/USDT,LINK/USDT
UNISWAP_PAIRS=WBTC/USDT,ETH/USDT,ETH/USDC,LINK/USDT,MATIC/USDT,UNI/USDT

# When PAIRS=ALL: include only spot markets whose quote currency is in this list.
# Prevents pulling thousands of obscure pairs from large exchanges like Binance.
# Max 200 pairs per worker regardless of filter (PAIRS_ALL_MAX can raise this).
PAIRS_ALL_QUOTE_FILTER=USDT,USDC,BTC,ETH

# Auto-spawner timing
EXCHANGES_WATCH_INTERVAL=60   # seconds between fleet health checks
EXCHANGES_SPAWN_DELAY=5       # seconds between each initial SPAWN on startup

# ── Graph arbitrage ────────────────────────────────────────────────────────────
GRAPH_ALGORITHM=bellman_ford
GRAPH_FW_INTERVAL_S=45
GRAPH_MAX_HOPS=5
GRAPH_MIN_HOPS=3
GRAPH_MIN_SPREAD_PCT=0.25
GRAPH_STALE_EDGE_S=15
GRAPH_START_ASSET=USDT
GRAPH_HUB_ASSETS=USDT,BTC,ETH,BNB,SOL,XRP
GRAPH_CAPITAL_USD=10000

# ── Per-exchange fees (taker %, e.g. 0.075 = 0.075%) ──────────────────────────
FEE_BINANCE_PCT=0.075
FEE_KRAKEN_PCT=0.16
FEE_BYBIT_PCT=0.10
FEE_COINBASE_PCT=0.40
FEE_UNISWAP_PCT=0.30
FEE_SUSHISWAP_PCT=0.30
FEE_PANCAKESWAP_PCT=0.25
FEE_CURVE_PCT=0.04

# ── DEX gas cap ────────────────────────────────────────────────────────────────
UNISWAP_MAX_GAS_USD=8.00

# ── Worker settings ────────────────────────────────────────────────────────────
TICK_INTERVAL_MS=2000
BALANCE_INTERVAL_S=60
CANDLE_INTERVAL_S=60
CANDLE_TIMEFRAMES=1m,5m,15m,1h,4h

# ── Fleet ──────────────────────────────────────────────────────────────────────
HEARTBEAT_TTL=45

# ── Decision engine ────────────────────────────────────────────────────────────
CR_MIN_SCORE=0.65
CR_MIN_RR=1.5
MAX_CAPITAL_PER_TRADE=1000
MAX_CONCURRENT_ORDERS=3
COOLDOWN_SECONDS=60
ORDER_SYNC_INTERVAL_S=30

# ── Risk manager ───────────────────────────────────────────────────────────────
MAX_DAILY_LOSS_USD=500
MAX_DRAWDOWN_PCT=10.0
MAX_CONSECUTIVE_LOSSES=5

# ── CRT 9AM model ──────────────────────────────────────────────────────────────
CANDLE_INTERVAL_S=60
CR_REVERSAL_RANGE=5am
CR_CONTINUATION_RANGE=1am
CR_TP1_PCT=0.50
CR_REQUIRE_BOS=true
CR_REQUIRE_FVG=false
CR_CHECK_H4=true
