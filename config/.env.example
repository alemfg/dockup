# ═══════════════════════════════════════════════════════════════════════════
# ARBX v2 — Environment Variables
# Copy to config/.env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Port configuration ─────────────────────────────────────────────────────
# Change any port if the default is already in use on your machine.
# Leave commented out to use the default.
#
# BRAIN_API_PORT=8000
# BRAIN_METRICS_PORT=9090
# FRONTEND_PORT=3000
# REDIS_PORT=6379
# POSTGRES_PORT=5432
# PROMETHEUS_PORT=9091
# GRAFANA_PORT=3001

# ── Brain settings ─────────────────────────────────────────────────────────
# DRY_RUN=true          # false = enable live trading (careful!)
# LOG_LEVEL=INFO        # DEBUG for verbose output
# BRAIN_API_HOST=0.0.0.0

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=arbitrage_secret
# POSTGRES_USER=arbitrage
# POSTGRES_DB=arbitrage

# ── Redis ──────────────────────────────────────────────────────────────────
# REDIS_HOST=localhost   (set automatically in Docker)

# ── CEX API Keys (all optional — workers simulate if absent) ───────────────
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# ── Worker pair lists (Docker Compose workers only) ────────────────────────
# Override which pairs each Docker worker collects.
# BINANCE_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT
# KRAKEN_PAIRS=BTC/USDT,ETH/USDT,XRP/USDT
# UNISWAP_PAIRS=ETH/USDT,WBTC/USDT,UNI/USDT

# ── Blockchain / DEX ───────────────────────────────────────────────────────
# WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/YOUR_KEY
# BSC_PROVIDER_URL=https://bsc-dataseed.binance.org/

# ── Worker ─────────────────────────────────────────────────────────────────
# BALANCE_INTERVAL_S=60     # how often workers fetch exchange balances (requires API key)


# TRADING_MODE=disabled     # disabled (default) | simulate | live
#                           # Can also be changed live from the dashboard


# NTFY_URL=https://ntfy.sh          # base URL (default: https://ntfy.sh for public server)
# NTFY_TOPIC=arbx-alerts            # setting this auto-enables ntfy alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_URL=

# ── Heartbeat ──────────────────────────────────────────────────────────────
# HEARTBEAT_TTL=45                  # seconds before a silent worker is declared dead

# ── Grafana ────────────────────────────────────────────────────────────────
# GRAFANA_PASSWORD=admin

# ── Decision Engine ────────────────────────────────────────────────────────
# DECISION_ENABLED=true
# CR_MIN_SCORE=0.65         # minimum CR signal score to act on
# CR_MIN_RR=1.5             # minimum risk/reward ratio
# MAX_CAPITAL_PER_TRADE=1000
# MAX_CONCURRENT_ORDERS=3
# COOLDOWN_SECONDS=60       # min seconds between orders on same pair
# ORDER_SYNC_INTERVAL_S=30  # how often workers fetch open orders from exchange

# ── Risk Manager ───────────────────────────────────────────────────────────
# MAX_DAILY_LOSS_USD=500
# MAX_DRAWDOWN_PCT=10.0
# MAX_CONSECUTIVE_LOSSES=5
