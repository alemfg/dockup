# ═══════════════════════════════════════════════════════════════════════════════
# ARBX v4.4 — Environment Variables Reference
# Copy to config/.env and fill in your values.
# NEVER commit .env to version control.
#
# Priority: env var > config.yaml > built-in default
# After changing any value: press "Reload Brain Config" or "Reload Workers Config"
# in the dashboard (Config & Reload tab) to apply without restart.
# Exception: BRAIN_API_PORT, REDIS_HOST, POSTGRES_HOST, EXCHANGE, WORKER_ID
# always require a container restart.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Ports ──────────────────────────────────────────────────────────────────────
# Change any port if the default is already in use on your machine.
#
# BRAIN_API_PORT=8000
# BRAIN_METRICS_PORT=9090
# FRONTEND_PORT=3000
# REDIS_PORT=6379
# POSTGRES_PORT=5432


# ── Brain ──────────────────────────────────────────────────────────────────────
# DRY_RUN=true                  # false = enable live trading (careful!)
# LOG_LEVEL=INFO                # DEBUG for every price tick; WARNING for quiet
# BRAIN_API_HOST=0.0.0.0
# TRADING_MODE=disabled         # disabled | simulate | live
#                               # Can also be toggled live from the dashboard


# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=arbitrage_secret
# POSTGRES_USER=arbitrage
# POSTGRES_DB=arbitrage


# ── Redis ──────────────────────────────────────────────────────────────────────
# REDIS_HOST=localhost           # set automatically inside Docker to "redis"


# ── CEX API Keys ───────────────────────────────────────────────────────────────
# All optional — workers simulate prices if absent.
# After adding a key: press "Reload Workers Config" in the dashboard.
#
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
#
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
#
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
#
# COINBASE_API_KEY=
# COINBASE_API_SECRET=


# ── Worker Pair Lists (Docker Compose workers) ─────────────────────────────────
# Which pairs each exchange worker streams to the brain.
# Recommended: Tier 1 hub pairs on all exchanges + exchange-specific pairs.
#
# ── Worker auto-spawn (v4.6) ─────────────────────────────────────────────────
# Set EXCHANGES and the brain will auto-spawn one worker per exchange.
# worker_manager must be running (it is in docker-compose by default).
EXCHANGES=binance,kraken,bybit,uniswap

# Pairs per exchange. Set to ALL to fetch the full market list via CCXT.
BINANCE_PAIRS=BTC/USDT,ETH/USDT,BTC/ETH,SOL/USDT,SOL/BTC,BNB/USDT,BNB/BTC,XRP/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,MATIC/USDT
KRAKEN_PAIRS=BTC/USDT,ETH/USDT,BTC/ETH,SOL/USDT,XRP/USDT,BTC/EUR,ETH/EUR,XRP/EUR,SOL/EUR,DOT/USDT
BYBIT_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,AVAX/USDT,DOGE/USDT,LINK/USDT
UNISWAP_PAIRS=WBTC/USDT,ETH/USDT,ETH/USDC,LINK/USDT,MATIC/USDT,UNI/USDT


# ── Graph Arbitrage — Algorithm ────────────────────────────────────────────────
# GRAPH_ALGORITHM=bellman_ford  # bellman_ford | floyd_warshall
#                               # bellman_ford: runs every ~5s, low latency
#                               # floyd_warshall: runs on schedule, finds all cycles
#                               # Note: when bellman_ford is active, floyd_warshall
#                               # still runs in the background every GRAPH_FW_INTERVAL_S
#                               # as a cross-check and merges any extra cycles found.
#
# GRAPH_FW_INTERVAL_S=45        # how often Floyd-Warshall deep scan runs (seconds)


# ── Graph Arbitrage — Cycle Constraints ───────────────────────────────────────
# GRAPH_MAX_HOPS=5              # maximum legs per cycle (5 = USDT→BTC→BNB→SOL→ETH→USDT)
# GRAPH_MIN_HOPS=3              # minimum legs (3 = classic triangular A→B→C→A)
# GRAPH_MIN_SPREAD_PCT=0.25     # minimum net profit % after all fees and gas
#                               # Rule of thumb: 2 CEX legs × 0.1% fee = 0.2% cost floor
#                               # Set 0.40 if you include DEX legs (higher gas+slippage)
# GRAPH_STALE_EDGE_S=15         # drop price edges older than this (seconds)
# GRAPH_START_ASSET=USDT        # preferred cycle start/end asset
# GRAPH_HUB_ASSETS=USDT,BTC,ETH,BNB,SOL,XRP
#                               # bridge assets used for multi-hop routing
#                               # Order matters: first = highest priority hub


# ── Graph Arbitrage — Per-Exchange Fees ───────────────────────────────────────
# Taker fee in percent (e.g. 0.075 means 0.075% = 0.00075 as a fraction).
# These are baked into every edge weight — accurate fees = accurate profit calc.
# BNB discount on Binance lowers it from 0.1% to 0.075% — use your actual tier.
#
# FEE_BINANCE_PCT=0.075         # 0.1% standard; 0.075% with BNB discount
# FEE_KRAKEN_PCT=0.16           # 0.16% at lowest volume tier; 0.10% above $50k/mo
# FEE_BYBIT_PCT=0.10
# FEE_COINBASE_PCT=0.40         # high — only worth it on large spreads
# FEE_UNISWAP_PCT=0.30          # 0.05% pool available on major pairs (WBTC/ETH etc.)
# FEE_SUSHISWAP_PCT=0.30
# FEE_PANCAKESWAP_PCT=0.25
# FEE_CURVE_PCT=0.04            # Curve is cheapest DEX for stablecoin pairs


# ── Graph Arbitrage — DEX Gas Cap ─────────────────────────────────────────────
# UNISWAP_MAX_GAS_USD=8.00      # skip DEX legs if estimated gas exceeds this
#                               # L1 Ethereum gas: $2-8 normal, $40+ congestion
#                               # Raise to 15-20 during low-congestion periods


# ── Graph Arbitrage — Capital ─────────────────────────────────────────────────
# GRAPH_CAPITAL_USD=10000       # simulation capital used for net profit calculation
#                               # does not affect order sizing — see MAX_CAPITAL_PER_TRADE


# ── Worker Settings ────────────────────────────────────────────────────────────
# TICK_INTERVAL_MS=2000         # milliseconds between price fetches per worker
# BALANCE_INTERVAL_S=60         # how often workers fetch exchange balances
# CANDLE_INTERVAL_S=60          # how often workers fetch OHLCV candles
# CANDLE_TIMEFRAMES=1m,5m,15m,1h,4h


# ── Decision Engine ────────────────────────────────────────────────────────────
# CR_MIN_SCORE=0.65             # minimum 9AM CR signal score (0.0–1.0) to act on
# CR_MIN_RR=1.5                 # minimum risk/reward ratio (e.g. 1.5 = TP ≥ 1.5× SL)
# MAX_CAPITAL_PER_TRADE=1000    # hard cap in USD per single trade
# MAX_CONCURRENT_ORDERS=3       # max open positions at once
# COOLDOWN_SECONDS=60           # min seconds between orders on same pair
# ORDER_SYNC_INTERVAL_S=30      # how often workers sync open order status


# ── Risk Manager ───────────────────────────────────────────────────────────────
# MAX_DAILY_LOSS_USD=500        # halt all trading if daily losses exceed this
# MAX_DRAWDOWN_PCT=10.0         # halt if portfolio drops this % below peak
# MAX_CONSECUTIVE_LOSSES=5      # halt after this many back-to-back losing trades


# ── CRT 9AM Model ──────────────────────────────────────────────────────────────
# CR_REVERSAL_RANGE=5am         # session candle used as range for Reversal setup
# CR_CONTINUATION_RANGE=1am     # session candle used for Continuation setup
# CR_TP1_PCT=0.50               # TP1 at this % of the range candle size
# CR_REQUIRE_BOS=true           # require Break of Structure confirmation
# CR_REQUIRE_FVG=false          # require Fair Value Gap in the setup
# CR_CHECK_H4=true              # check H4 candle for manipulation context


# ── Alerts ─────────────────────────────────────────────────────────────────────
# Setting NTFY_TOPIC or SLACK_WEBHOOK_URL auto-enables that alert channel.
#
# NTFY_URL=https://ntfy.sh      # base URL (default: public ntfy.sh server)
# NTFY_TOPIC=arbx-alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_URL=


# ── Fleet ──────────────────────────────────────────────────────────────────────
# HEARTBEAT_TTL=45              # seconds of silence before a worker is marked dead
#                               # default = 3× heartbeat interval (15s) + 10s buffer


# ── Blockchain / DEX (optional) ────────────────────────────────────────────────
# Required only if using Uniswap/Sushiswap/Curve workers with real on-chain data.
# WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/YOUR_KEY
# BSC_PROVIDER_URL=https://bsc-dataseed.binance.org/
